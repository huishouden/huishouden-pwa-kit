{
  "name": "@huishouden/pwa-kit",
  "version": "0.17.0",
  "description": "Building blocks for small installable web apps on Firebase Hosting: Vite PWA preset, Firebase config, Playwright smoke checks, reusable CI.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./app-bar": {
      "types": "./dist/app-bar.d.ts",
      "default": "./dist/app-bar.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./calendar": {
      "types": "./dist/calendar.d.ts",
      "default": "./dist/calendar.js"
    },
    "./contacts": {
      "types": "./dist/contacts.d.ts",
      "default": "./dist/contacts.js"
    },
    "./design-check": {
      "types": "./dist/design-check.d.ts",
      "default": "./dist/design-check.js"
    },
    "./e2e": {
      "types": "./dist/e2e.d.ts",
      "default": "./dist/e2e.js"
    },
    "./firebase": {
      "types": "./dist/firebase.d.ts",
      "default": "./dist/firebase.js"
    },
    "./household": {
      "types": "./dist/household.d.ts",
      "default": "./dist/household.js"
    },
    "./invite": {
      "types": "./dist/invite.d.ts",
      "default": "./dist/invite.js"
    },
    "./logo": {
      "types": "./dist/logo.d.ts",
      "default": "./dist/logo.js"
    },
    "./oauth-origins": {
      "types": "./dist/oauth-origins.d.ts",
      "default": "./dist/oauth-origins.js"
    },
    "./places": {
      "types": "./dist/places.d.ts",
      "default": "./dist/places.js"
    },
    "./react/app-bar": {
      "types": "./dist/react/app-bar.d.ts",
      "default": "./dist/react/app-bar.js"
    },
    "./theme.css": "./src/theme.css",
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "bin": {
    "pwa-icons": "./scripts/icons.ts",
    "pwa-design-check": "./scripts/design-check.ts",
    "pwa-logo": "./scripts/logo.ts",
    "pwa-oauth-origins": "./scripts/oauth-origins.ts"
  },
  "files": [
    "DESIGN.md",
    "dist",
    "infra",
    "scripts",
    "src/theme.css",
    "templates"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "test": "bun test test"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.45",
    "sharp": ">=0.33",
    "vite-plugin-pwa": ">=1.0",
    "firebase": ">=11",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "sharp": {
      "optional": true
    },
    "firebase": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@playwright/test": "^1.56.0",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase": "^12",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
